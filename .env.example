# ─────────────────────────────────────────────────────────────────────────────
# AI Resume Matcher — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and should NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Authentication ────────────────────────────────────────────────────────
# Comma-separated API keys for X-API-Key header authentication.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AI_MATCHER_API_KEYS=your-api-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (default works with docker-compose.yml)
DATABASE_URL=postgresql://matcher:matcher_secret@localhost:5432/resume_matcher

# ── LLM Model ────────────────────────────────────────────────────────────────
# Override config.yaml model setting (optional)
# MODEL=ollama/llama3
# MODEL=anthropic/claude-3-sonnet-20240229

# ── LLM Provider API Keys (if using cloud models) ────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# ── Observability (LangFuse) ─────────────────────────────────────────────────
# Sign up at https://cloud.langfuse.com or use a self-hosted instance.
# Create a project → Settings → API Keys to get these values.
# If these are not set, tracing is silently disabled (pipeline runs normally).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Set to "false" to disable tracing even when keys are present
# LANGFUSE_ENABLED=true

# ── Bi-Frost Gateway (BT GenAI Gateway) ─────────────────────────────────────
# BT's enterprise AI gateway for centralized model access, governance, and compliance.
# If BIFROST_BASE_URL is not set, all LLM calls go directly to litellm providers.
BIFROST_BASE_URL=https://bifrost-gateway.internal.bt.com/v1
BIFROST_API_KEY=bf-...
BIFROST_DEFAULT_MODEL=anthropic/claude-3-sonnet

# Metadata for cost attribution and compliance tagging
BIFROST_PROJECT_ID=ai-resume-matcher
BIFROST_COST_CENTER=
BIFROST_USE_CASE=recruitment-automation

# PII routing: Which stages can send data through the gateway?
#   "all"     — All stages go through gateway
#   "none"    — All stages stay local
#   not set   — Default (JD + Explainability through gateway, Resume stays local)
# BIFROST_PII_STAGES=
